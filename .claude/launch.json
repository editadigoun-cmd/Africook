      "runtimeArgs": ["run", "-d", "android", "--debug"],
      "port": null
    },
    {
      "name": "Africook — Flutter (iOS)",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "ios", "--debug"],
      "port": null
    },
    {
      "name": "Africook — Flutter (Chrome / Web preview)",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "chrome", "--web-port", "3000"],
